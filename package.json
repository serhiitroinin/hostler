{
  "name": "hostler",
  "version": "2.0.0",
  "description": "CLI tool to manage local development domains with nginx",
  "type": "module",
  "module": "src/index.ts",
  "bin": {
    "hostler": "src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "build": "bun build ./src/index.ts --compile --minify --outfile hostler",
    "build:linux-x64": "bun build ./src/index.ts --compile --minify --target=bun-linux-x64 --outfile dist/hostler-linux-x64",
    "build:linux-arm64": "bun build ./src/index.ts --compile --minify --target=bun-linux-arm64 --outfile dist/hostler-linux-arm64",
    "build:darwin-x64": "bun build ./src/index.ts --compile --minify --target=bun-darwin-x64 --outfile dist/hostler-darwin-x64",
    "build:darwin-arm64": "bun build ./src/index.ts --compile --minify --target=bun-darwin-arm64 --outfile dist/hostler-darwin-arm64",
    "build:all": "bun run build:linux-x64 && bun run build:linux-arm64 && bun run build:darwin-x64 && bun run build:darwin-arm64",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "license": "MIT"
}
